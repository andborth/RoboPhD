{
  "comment": "CodeGen domain test with simple meta-evolution. Starts simple meta-evolution at iteration 4. Repeats meta-evolution every 3 iterations.",
  "domain": "codegen",
  "coder_model": "haiku-4.5",
  "critic_model": "haiku-4.5",
  "evolution_model": "opus-4.6",
  "meta_evolution_model": "opus-4.6",
  "dollar_budget": 450.0,
  "examples_per_iteration": 60,
  "agents_directory": "RoboPhD/codegen_agents",
  "strategies_directory": "RoboPhD/evolution_strategies_codegen",
  "initial_agents": [
    "naive_critic"
  ],
  "initial_strategies": [
    "cross_pollination_tool_only",
    "refinement_tool_only"
  ],
  "config_schedule": {
    "2": {
      "evolution_strategy": "refinement_tool_only"
    },
    "3": {
      "evolution_strategy": "cross_pollination_tool_only"
    },
    "4": {
      "meta_evolution_strategy": "train_a_new_winner_simple"
    },
    "5": {
      "meta_evolution_strategy": null
    },
    "7": {
      "meta_evolution_strategy": "train_a_new_winner_simple"
    },
    "8": {
      "meta_evolution_strategy": null
    },
    "10": {
      "meta_evolution_strategy": "train_a_new_winner_simple"
    },
    "11": {
      "meta_evolution_strategy": null
    },
    "13": {
      "meta_evolution_strategy": "train_a_new_winner_simple"
    },
    "14": {
      "meta_evolution_strategy": null
    }
  }
}