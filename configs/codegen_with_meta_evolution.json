{
  "comment": "CodeGen domain test with meta-evolution. Starts meta-evolution at iteration 4. Repeats meta-evolution every 3 iterations.",
  "domain": "codegen",
  "coder_model": "haiku-4.5",
  "critic_model": "haiku-4.5",
  "evolution_model": "opus-4.6",
  "meta_evolution_model": "opus-4.6",
  "dollar_budget": 450.0,
  "examples_per_iteration": 60,
  "agents_directory": "RoboPhD/codegen_agents",
  "initial_agents": [
    "naive_critic"
  ],
  "initial_strategies": [
    "cross_pollination",
    "refinement"
  ],
  "config_schedule": {
    "2": {
      "evolution_strategy": "refinement"
    },
    "3": {
      "evolution_strategy": "cross_pollination"
    },
    "4": {
      "meta_evolution_strategy": "train_a_winner"
    },
    "5": {
      "meta_evolution_strategy": null
    },
    "7": {
      "meta_evolution_strategy": "train_a_winner"
    },
    "8": {
      "meta_evolution_strategy": null
    },
    "10": {
      "meta_evolution_strategy": "train_a_winner"
    },
    "11": {
      "meta_evolution_strategy": null
    },
    "13": {
      "meta_evolution_strategy": "train_a_winner"
    },
    "14": {
      "meta_evolution_strategy": null
    }
  }
}
