{
  "comment": "CodeGen small test with meta-evolution.  Strictly for a demo.  See configs/codegen_with_simple_meta_evolution.json for a more realistic config.",
  "domain": "codegen",
  "coder_model": "haiku-4.5",
  "critic_model": "haiku-4.5",
  "evolution_model": "haiku-4.5",
  "meta_evolution_model": "haiku-4.5",
  "examples_per_iteration": 15,
  "agents_directory": "RoboPhD/codegen_agents",
  "initial_agents": [
    "naive_critic"
  ],
  "initial_strategies": [
    "cross_pollination",
    "refinement"
  ],
  "config_schedule": {
    "2": {
      "evolution_strategy": "refinement"
    },
    "3": {
      "evolution_strategy": "cross_pollination",
      "meta_evolution_strategy": "train_a_winner"
    },
    "4": {
      "meta_evolution_strategy": null
    }
  }
}
