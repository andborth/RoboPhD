# Can't Be Late traces (download with examples/cant_be_late/download_traces.sh)
examples/cant_be_late/data/traces/

# Protein GO data (SwissProt, DIAMOND index, ProteInfer splits, Price-149, JSONL — built by examples/protein_go/setup.sh)
